// ---- reaction-front spread rates (tools/VALIDATION.md §9, row 5) ----
// Contact ignition (a burning/hot neighbour, a flame touching the surface) is probabilistic: per update a cell
// lights with probability 1 - exp(-dt * spread), so a front advances at ~`spread` cells per time unit instead of one
// cell per wall step (2600 m/s for every mixture before). Conduction that heats the cell itself above its ignition
// temperature still lights it deterministically (pressed grains, heated charges). Values: cells / time unit
// (1 cell/unit ~ 32 cells per game second at 1x); >= 50 = no gate (flash powder, LOX mixes, blasting caps).
// (E_SPREAD per element: see the GEN block)
// Oxidiser + fuel mixtures (loose, intimately mixed powders/liquids), before the Saint-Robert p^0.35 factor.
fn pair_spread(ox: u32, fuel: u32) -> f32 {
    let metal = is_metal_fuel(fuel);
    if (ox == 22u) { return 100.0; }                    // LOX + fuel: violent
    if ((ox == 82u || ox == 84u) && fuel == 83u) { return 100.0; } // hypergolic: ignites on contact
    if (ox == 69u) { return select(0.3, 100.0, metal || fuel == 73u); } // chlorate mixtures are touchy
    if (ox == 70u) { return 0.06; }                     // sodium nitrate: slow, yellow
    if (ox == 47u && metal) { return 100.0; }           // flash powder: ~300 m/s unconfined
    if (ox == 17u) { return 0.05; }                     // iron thermite: slow white-hot pour (1-10 cm/s)
    if (ox == 59u) { return 0.5; }                      // copper thermite: much faster
    if (ox == 16u) { return select(0.05, 0.08, metal); } // AP composites (loose): seconds-long burn
    if (ox == 18u) { return 0.05; }                     // ANFO deflagrates poorly
    if (ox == 60u) { return select(0.2, 0.08, fuel == 61u); }
    if (ox == 13u) {
        if (fuel == 11u || fuel == 12u) { return 0.15; } // black-powder mix train
        if (fuel == 14u) { return 0.08; }                // loose rocket candy
        return 0.1;
    }
    return 0.2;
}
// airborne grains in hot gas: mean ignition delay 1/DUST_IGN time units (particle heat-up + volatile release)
const DUST_IGN: f32 = 3.0;
const K_SURF_O2: f32 = 10.0;
fn spread_ok(rate: f32, dt: f32, rnd: f32) -> bool { return rate >= 50.0 || rnd < 1.0 - exp(-dt * rate); }

// ---- hooks for sim.wgsl / vis.wgsl (so new elements get proper thermal properties and colours) ----
fn elem_of(i: u32) -> u32 { return min((META[i] >> 8u) & 0xFFu, N_ELEM - 1u); }
fn m_cap(m: u32) -> f32 { return select(M_CAP[min(m, 25u)], E_CAP[min(m, N_ELEM - 1u)], m >= 10u); }
fn m_cond(m: u32) -> f32 { return select(M_COND[min(m, 25u)], E_COND[min(m, N_ELEM - 1u)], m >= 10u); }
fn m_col(m: u32) -> vec3<f32> { return select(M_COL[min(m, 25u)], E_COL[min(m, N_ELEM - 1u)], m >= 10u); }
fn m_phase(m: u32) -> u32 { return E_PHASE[min(m, N_ELEM - 1u)]; }

fn is_fuel(e: u32) -> bool {
    return e == 11u || e == 12u || e == 14u || e == 15u || e == 20u || e == 21u || e == 31u || e == 32u
        || e == 33u || e == 34u || e == 36u || e == 37u || e == 38u || e == 39u || e == 40u || e == 61u
        || e == 63u || e == 64u || e == 66u || e == 67u || (e >= 71u && e <= 81u) || e == 83u;
}
fn is_oxidiser(e: u32) -> bool {
    return e == 13u || e == 16u || e == 17u || e == 18u || e == 22u || e == 47u || e == 59u || e == 60u
        || e == 69u || e == 70u || e == 82u || e == 84u;
}
fn is_liquid(e: u32) -> bool { return E_PHASE[e] == 2u; }
fn is_metal_fuel(e: u32) -> bool { return e == 15u || e == 39u || e == 71u || e == 72u; }
// aqueous: water and water-based solutions (react with alkali metals, dissolve salt)
fn is_aqueous(e: u32) -> bool { return e == 19u || e == 29u || e == 43u || e == 44u || e == 45u; }
// hot liquids that make water flash into steam explosively (fuel-coolant interaction / grease fires)
fn is_hot_liquid(e: u32) -> bool { return e == 24u || e == 54u || e == 55u || e == 33u || e == 34u || e == 36u || e == 63u || e == 32u; }
fn is_explosive(e: u32) -> bool { return E_DETP[e] < 1e8 || E_DETT[e] < 90.0; }

// Pair reaction between an oxidiser cell and a neighbouring fuel cell.
// Returns (ignition T, rate constant, flame T, gas yield). Rate constant 0 = no reaction.
fn pair_params(ox: u32, fuel: u32) -> vec4<f32> {
    let metal = is_metal_fuel(fuel);
    if (ox == 17u) {
        // thermite: rust + aluminium (hard to light, molten iron, no gas); magnesium thermite lights easier
        if (fuel == 15u) { return vec4<f32>(4.5, 1.0, 10.4, 0.0); }  // ~3100 K adiabatic
        if (fuel == 39u) { return vec4<f32>(3.5, 1.5, 10.4, 0.1); }
        return vec4<f32>(99.0, 0.0, 1.0, 0.0);
    }
    if (ox == 59u) {
        // copper thermite: much faster than iron thermite, partly vaporises the copper (a bang, not a pour)
        if (fuel == 15u) { return vec4<f32>(3.8, 5.0, 10.0, 0.35); }
        if (fuel == 39u) { return vec4<f32>(3.0, 6.0, 10.0, 0.35); }
        return vec4<f32>(99.0, 0.0, 1.0, 0.0);
    }
    var p = vec4<f32>(99.0, 0.0, 1.0, 0.0);
    if (ox == 82u) {
        // nitric acid: hypergolic with hydrazine, otherwise a sluggish oxidiser
        if (fuel == 83u) { return vec4<f32>(0.9, 6.0, 9.0, 1.0); }
        if (fuel == 81u || fuel == 80u || fuel == 20u || fuel == 31u || fuel == 32u) { return vec4<f32>(2.4, 0.8, 7.0, 0.9); }
        return vec4<f32>(99.0, 0.0, 1.0, 0.0);
    }
    if (ox == 84u) {
        // dinitrogen tetroxide: the classic hypergolic storable pair with hydrazine
        if (fuel == 83u) { return vec4<f32>(0.9, 8.0, 10.5, 1.0); }
        return vec4<f32>(2.0, 3.0, 9.0, 0.9);
    }
    if (ox == 13u) { p = vec4<f32>(2.0, 1.5, 7.3, 0.45); }       // saltpeter: black powder / rocket candy / sparklers
    else if (ox == 16u) { p = vec4<f32>(2.0, 3.0, 10.0, 0.9); }  // ammonium perchlorate: APCP-like composites
    else if (ox == 18u) { p = vec4<f32>(2.3, 0.5, 8.0, 1.0); }   // ammonium nitrate: ANFO (deflagrates poorly)
    else if (ox == 22u) { p = vec4<f32>(1.0, 8.0, 11.0, 1.0); }  // liquid oxygen + fuel: violent
    else if (ox == 69u) {
        // potassium chlorate: lights at lower temperature than the perchlorate, red P mixes are shock sensitive
        if (metal || fuel == 73u) { return vec4<f32>(1.6, 25.0, 11.0, 0.6); }
        p = vec4<f32>(1.75, 4.0, 8.3, 0.6);
    } else if (ox == 70u) { p = vec4<f32>(2.1, 1.0, 6.7, 0.45); }
    else if (ox == 47u) {
        // potassium perchlorate: with metal powder = flash powder (explodes even unconfined)
        if (metal) { return vec4<f32>(1.9, 25.0, 11.0, 0.6); }
        p = vec4<f32>(2.0, 3.0, 8.0, 0.6);
    } else if (ox == 60u) {
        // permanganate + glycerin ignites by itself after a few seconds (no flame needed)
        if (fuel == 61u) { return vec4<f32>(0.95, 0.12, 5.5, 0.4); }
        p = vec4<f32>(2.0, 1.0, 6.0, 0.4);
    }
    if (fuel == 40u) { p = vec4<f32>(p.x + 0.3, p.y * 0.4, 6.0, p.w * 0.3); } // iron filings: sparkler sparks
    if (metal && p.y > 0.0) { p.y *= 1.5; p.z = min(p.z + 1.5, 11.5); }
    return p;
}

fn mhash(x: u32, y: u32, f: u32) -> f32 {
    var h = x * 0x9E3779B1u ^ y * 0x85EBCA77u ^ f * 0xC2B2AE3Du;
    h ^= h >> 15u;
    h *= 0x2C1B3C6Du;
    h ^= h >> 12u;
    h *= 0x297A2D39u;
    h ^= h >> 15u;
    return f32(h & 0xFFFFu) / 65535.0;
}

// Per-face gas emission for the post pass: kind 1 vapour, 2 O2 release, 3 hot products, 4 burning in air,
// 5 fuel gas (hydrogen from metals + water/acid), 6 peroxide decomposition (O2 + steam), 7 inert steam/CO2.
fn emit_code(kind: u32, rate: f32) -> f32 { return f32(kind) * 1000.0 + clamp(rate, 0.0, 999.0); }
fn req_conv(id: u32) -> f32 { return 0.55 + f32(id) * 0.001; }
fn settled(p: f32) -> f32 { return 0.1 + 0.4 * clamp(p, 0.0, 1.0); }

// ---- cast / pressed grains: surface regression r = a p^n ----
// (a = cells per time unit at 1 atm, n = pressure exponent, flame T in 300 K units, gas yield). 1 cell / unit = 32 cm
// per game second, so a = 0.12 is ~4 cm/s of game time at 1 atm. Real data (r in mm/s at 1 atm, n): KNO3/sugar 1.3,
// 0.32; KNO3/sorbitol 1.0, 0.35; black powder (pressed) 6-10, 0.3; APCP 4-8, 0.35; KClO4/sugar 2-4, 0.5.
const CAST_BIT: u32 = 0x10000u;
const CAST_SPREAD: f32 = 1.2;  // flame spread over an exposed grain surface (cells / time unit)
fn cast_burn(ox: u32, fu: u32) -> vec4<f32> {
    let metal = is_metal_fuel(fu);
    if (ox == 13u) {
        if (fu == 14u || fu == 74u || fu == 75u) { return vec4<f32>(select(0.12, 0.1, fu == 74u), 0.32, 5.7, 0.45); }
        if (fu == 11u || fu == 12u) { return vec4<f32>(0.4, 0.3, 7.4, 0.45); }
        if (metal) { return vec4<f32>(0.3, 0.4, 9.0, 0.6); }
        return vec4<f32>(0.2, 0.35, 6.5, 0.45);
    }
    if (ox == 16u) {
        if (fu == 15u) { return vec4<f32>(0.16, 0.35, 10.6, 0.9); }
        if (fu == 66u || fu == 67u) { return vec4<f32>(0.11, 0.35, 8.8, 0.95); }
        if (fu == 14u || fu == 74u || fu == 75u) { return vec4<f32>(0.18, 0.4, 8.0, 0.85); }
        return vec4<f32>(0.12, 0.4, 8.0, 0.9);
    }
    if (ox == 47u) { return select(vec4<f32>(0.2, 0.5, 8.5, 0.6), vec4<f32>(0.5, 0.6, 10.5, 0.6), metal); }
    if (ox == 69u) { return select(vec4<f32>(0.28, 0.5, 8.5, 0.6), vec4<f32>(0.6, 0.6, 10.5, 0.6), metal); }
    if (ox == 70u) { return vec4<f32>(0.07, 0.3, 5.2, 0.4); }
    if (ox == 18u) { return select(vec4<f32>(0.04, 0.7, 7.0, 1.0), vec4<f32>(0.07, 0.6, 9.5, 1.0), metal); }
    if (ox == 82u || ox == 84u) { return vec4<f32>(0.3, 0.5, 9.0, 1.0); }
    return vec4<f32>(0.1, 0.4, 6.0, 0.6);
}
fn cast_ign(ox: u32, fu: u32) -> f32 {
    if (ox == 16u || ox == 18u) { return 2.3; }
    if (ox == 47u || ox == 69u) { return 2.1; }
    return 2.0;
}

// Matter-cell update, called from the wall pass after heat transfer (ntw = new temperature).
// Returns the new WALL value (T, flag, emission code, remaining). `e_in` may be clamped by sim.wgsl's
// mat_of; the real id is re-read from META.
fn matter_update(i: u32, x: i32, y: i32, e_in: u32, ntw: f32, rem0: f32, exposed: f32,
                 gp_avg: f32, gp_max: f32, gt_max: f32, o2_avg: f32, dt: f32) -> vec4<f32> {
    let e = elem_of(i);
    let w0 = WALL[i];
    // a conversion is pending (the movement pass applies it)
    if (w0.y >= 0.55 && w0.y < 0.95) { return w0; }
    var t = ntw;
    if (w0.y == 0.0 && e != 24u && e != 25u) { t = E_TINIT[e]; }
    var rem = rem0;
    var prog = clamp((w0.y - 0.1) / 0.4, 0.0, 1.0);
    var code = 0.0;
    let ex = max(exposed, 1.0);
    let rnd = mhash(u32(x), u32(y), P.frame);
    // per-update random number for contact ignition (rnd is constant over a frame's steps)
    let rnd2 = mhash(u32(x) ^ bitcast<u32>(ntw), u32(y) ^ bitcast<u32>(rem0), P.frame);

    // ---- molten metal: remembers its original wall material in WALL.z (thermite iron = steel) ----
    if (e == 24u) {
        let z = w0.z;
        let orig = select(0u, u32(z), z >= 0.5 && z < 7.0);
        let t_solid = select(6.0, M_TMELT[orig] - 0.05, z >= 0.5);
        var fl = 0.1;
        if (t < t_solid) { fl = 3.0; }
        return vec4<f32>(t, fl, z, rem);
    }

    // ---- neighbourhood scan (8-connected) ----
    var best = vec4<f32>(99.0, 0.0, 1.0, 0.0);
    var spr = 0.0;        // fastest front spread rate among the mixture partners
    var npart = 0.0;
    var hot_partner = 0.0;
    var thermite = false;
    var anfo = false;
    var n_aq = 0.0;       // water / aqueous solutions
    var n_water = 0.0;    // plain water or brine (dissolves salt, rusts iron)
    var n_brine = 0.0;
    var n_salt = 0.0;
    var n_acid = 0.0;
    var n_base = 0.0;
    var n_alkali = 0.0;   // sodium / potassium
    var n_metal = 0.0;    // metals that acids attack
    var cat = 0.0;        // peroxide catalysts
    var hot_liq = 0.0;
    var n_cc = 0.0;       // copper chromite (burn-rate catalyst)
    var n_bind = 0.0;     // binders (HTPB, epoxy)
    var csum = vec4<f32>(0.0);
    var cign = 0.0;
    var tn_max = 0.0;     // hottest touching solid/matter (flame spreads by contact)
    let ox_e = is_oxidiser(e);
    let fu_e = is_fuel(e);
    for (var dy = -1; dy <= 1; dy++) {
        for (var dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) { continue; }
            let ax = x + dx;
            let ay = y + dy;
            if (ax < 0 || ay < 0 || ax >= i32(P.w) || ay >= i32(P.h)) { continue; }
            let j = u32(ay) * P.w + u32(ax);
            let tlj = tile_of(j);
            if (tlj == 1u) { tn_max = max(tn_max, WALL[j].x); }
            if (tlj != MATTER) { continue; }
            let f = elem_of(j);
            let tj = WALL[j].x;
            tn_max = max(tn_max, tj);
            var pp = vec4<f32>(99.0, 0.0, 1.0, 0.0);
            var ps = 0.0;
            if (ox_e && is_fuel(f)) { pp = pair_params(e, f); ps = pair_spread(e, f); }
            else if (fu_e && is_oxidiser(f)) { pp = pair_params(f, e); ps = pair_spread(f, e); }
            if (pp.y > 0.0) {
                npart += 1.0;
                spr = max(spr, ps);
                best = pp;
                hot_partner = max(hot_partner, tj);
                if ((e == 17u || e == 59u) && is_metal_fuel(f)) { thermite = true; }
                if ((f == 17u || f == 59u) && is_metal_fuel(e)) { thermite = true; }
                if (e == 18u || f == 18u) { anfo = true; }
                let po = select(f, e, ox_e && is_fuel(f));
                let pf = select(e, f, ox_e && is_fuel(f));
                csum += cast_burn(po, pf);
                cign += cast_ign(po, pf);
            }
            if (f == 68u) { n_cc += 1.0; }
            if (f == 66u || f == 67u) { n_bind += 1.0; }
            if (is_aqueous(f)) { n_aq += 1.0; }
            if (f == 19u || f == 29u) { n_water += 1.0; }
            if (f == 29u) { n_brine += 1.0; }
            if (f == 28u) { n_salt += 1.0; }
            if (f == 44u || f == 82u) { n_acid += 1.0; }
            if (f == 43u) { n_base += 1.0; }
            if (f == 41u || f == 42u) { n_alkali += 1.0; }
            if (f == 15u || f == 39u || f == 40u || f == 41u || f == 42u) { n_metal += 1.0; }
            if (f == 46u || f == 60u) { cat += 1.0; }
            if (f == 17u) { cat += 0.35; }
            if (f == 40u) { cat += 0.15; }
            if (is_hot_liquid(f) && tj > 1.9) { hot_liq = max(hot_liq, tj); }
        }
    }

    // ---- explosives: detonation by shock or heat; burning when lit ----
    if (e == 23u && (t > E_DETT[e] || gp_max > E_DETP[e] || gt_max > 5.0)) { return vec4<f32>(t, 2.0, 0.0, rem); }
    if (e == 52u && (t > E_DETT[e] || gp_max > E_DETP[e] || gt_max > 3.5)) { return vec4<f32>(t, 2.0, 0.0, rem); }
    let sp = E_SELF[e];
    // (a charge that is already burning makes its own pressure: that alone doesn't make it detonate)
    let self_burning = sp.y > 0.0 && t > sp.x + 0.3;
    if (is_explosive(e) && ((gp_max > E_DETP[e] && !self_burning) || t > E_DETT[e])) { return vec4<f32>(t, 2.0, 0.0, rem); }
    // a fuse is only lit by a real flame and creeps along at ~15 cells/s; other energetics catch easily
    let gas_lit = select(max(sp.x + 1.2, 3.2), 5.0, e == 65u);
    let touch_lit = select(max(sp.x + 1.0, 2.5), 3.5, e == 65u);
    // Saint-Robert: fronts creep faster under pressure (p^0.35)
    let pfac = pow(clamp(gp_max, 1.0, 300.0), 0.35);
    let self_contact = (gt_max > gas_lit || tn_max > touch_lit) && spread_ok(E_SPREAD[e] * pfac, dt, rnd2);
    if (sp.y > 0.0 && (t > sp.x || self_contact)) {
        // self-oxidising: burns from its surface inward, faster under pressure (Saint-Robert)
        let tt = max(t, sp.x + 0.05);
        var r = sp.y * (1.0 + 0.5 * clamp(tt - sp.x, 0.0, 4.0)) * pow(max(gp_max, 1.0), 0.5);
        r *= select(0.4, 1.0, exposed > 0.0); // buried grains burn slower (heated through)
        rem -= dt * r;
        t = tt + (sp.z - tt) * min(1.0, dt * r * 6.0);
        if (exposed > 0.0) { code = emit_code(3u, r * MATTER_MASS * sp.w / ex); }
        if (rem <= 0.0) { return vec4<f32>(t, select(1.6, 1.5, exposed > 2.0), code, 0.0); }
        return vec4<f32>(t, settled(prog), code, rem);
    }

    // ---- boiling (with latent heat) and evaporation of volatile liquids ----
    let tb = E_TBOIL[e];
    let can_boil = (is_liquid(e) || e == 58u) && tb < 90.0;
    // a flame over a pool keeps its surface at the boiling point (pool fires sustain themselves)
    if (can_boil && fu_e && exposed > 0.0 && gt_max > tb + 0.3) { t = max(t, tb + 0.05 + 0.03 * (gt_max - tb)); }
    if (can_boil && exposed > 0.0) {
        var ev = 0.0;
        if (t > tb) { ev = 0.6 * (t - tb); }
        if (E_VOLAT[e] > 0.0 && t > 0.85) { ev += E_VOLAT[e] * exp(4.0 * (min(t, tb) - 1.0)); }
        if (ev > 0.0) {
            rem -= dt * ev * exposed / MATTER_MASS;
            if (t > tb) {
                t -= dt * ev * exposed * E_LATENT[e] / MATTER_MASS;
                t = max(t, tb);
            }
            code = emit_code(1u, ev);
        }
        // boiling brine down leaves salt crystals behind
        if (e == 29u && rem < 0.35) { return vec4<f32>(t, req_conv(28u), 0.0, 1.0); }
    }

    // ---- water chemistry ----
    if (e == 19u || e == 29u) {
        // steam explosion: water touching molten metal, lava or burning oil flashes to steam
        if (hot_liq > 1.9 && rnd < 0.5) { return vec4<f32>(max(t, 2.0), 1.6, 0.0, 0.0); }
        // alkali metals turn the water around them into lye
        if (n_alkali > 0.0 && rnd < 0.004 * n_alkali) { return vec4<f32>(t + 0.2, req_conv(43u), 0.0, 1.0); }
    }
    if (e == 28u && n_water > 0.0 && rnd < 0.006 * n_water) { return vec4<f32>(t, req_conv(29u), 0.0, 1.0); }

    // ---- alkali metals (and hot magnesium) with water: hydrogen + heat ----
    let alk = select(0.0, 0.03, e == 41u) + select(0.0, 0.1, e == 42u) + select(0.0, 0.6, e == 39u && t > 2.0);
    if (alk > 0.0 && n_aq > 0.0) {
        let r = alk * (n_aq / 8.0) * (1.0 + 0.5 * clamp(t - 1.0, 0.0, 3.0));
        rem -= dt * r;
        let tgt = select(3.3, 4.3, e == 42u);
        t += (select(tgt, 10.3, e == 39u) - t) * min(1.0, dt * r * 12.0);
        code = emit_code(5u, r * MATTER_MASS * 0.3 / ex);
        // potassium (and big sodium lumps) shatter violently: small explosions
        if (e == 42u && t > 3.0 && n_aq >= 2.0 && rnd < 0.01) { return vec4<f32>(t, 1.6, code, 0.0); }
        if (rem <= 0.0) {
            if (e == 39u) { return vec4<f32>(t, req_conv(25u), 0.0, 1.0); }
            return vec4<f32>(t, req_conv(43u), 0.0, 1.0); // dissolved: sodium/potassium hydroxide solution
        }
        return vec4<f32>(t, settled(prog), code, rem);
    }

    // ---- acids and bases ----
    if (n_acid > 0.0) {
        var r = 0.0;
        if (e == 39u) { r = 1.2; }        // magnesium fizzes hard
        else if (e == 15u) { r = 0.4; }   // aluminium
        else if (e == 40u) { r = 0.15; }  // iron, slowly
        else if (e == 17u) { r = 0.2; }   // rust dissolves (no gas)
        else if (e == 59u) { r = 0.2; }
        if (r > 0.0) {
            r *= n_acid / 8.0;
            rem -= dt * r;
            t += 0.6 * dt * r;            // exothermic
            if (e != 17u && e != 59u) { code = emit_code(5u, r * MATTER_MASS * 0.1 / ex); }
            if (rem <= 0.0) { return vec4<f32>(t, 1.5, code, 0.0); }
            return vec4<f32>(t, settled(prog), code, rem);
        }
    }
    if (e == 15u && n_base > 0.0) {
        // aluminium in lye (drain cleaner): hydrogen
        let r = 0.3 * n_base / 8.0 * (1.0 + clamp(t - 1.0, 0.0, 2.0));
        rem -= dt * r;
        t += 0.8 * dt * r;
        code = emit_code(5u, r * MATTER_MASS * 0.1 / ex);
        if (rem <= 0.0) { return vec4<f32>(t, 1.5, code, 0.0); }
        return vec4<f32>(t, settled(prog), code, rem);
    }
    if (e == 44u) {
        // neutralisation with lye: salt water + heat; acid eaten by metals turns into a salt solution
        if (n_base > 0.0 && rnd < 0.08 * n_base) { return vec4<f32>(t + 0.25, req_conv(29u), emit_code(7u, 2.0), 1.0); }
        if (n_metal > 0.0 && rnd < 0.004 * n_metal) { return vec4<f32>(t + 0.05, req_conv(29u), 0.0, 1.0); }
    }
    if (e == 43u && n_acid > 0.0 && rnd < 0.08 * n_acid) { return vec4<f32>(t + 0.25, req_conv(29u), emit_code(7u, 2.0), 1.0); }

    // ---- hydrogen peroxide: decomposes on catalysts (MnO2, permanganate, rust) or when hot -> O2 + steam ----
    if (e == 45u) {
        var r = 2.5 * cat / 8.0 * (1.0 + clamp(t - 1.0, 0.0, 3.0));
        if (t > 1.4) { r += 0.8 * (t - 1.4); }  // thermal runaway
        if (r > 0.0) {
            rem -= dt * r;
            t += (3.4 - t) * min(1.0, dt * r * 3.0); // 90 % HTP decomposes adiabatically at ~1020 K
            code = emit_code(6u, r * MATTER_MASS / ex);
            if (rem <= 0.0) { return vec4<f32>(t, select(1.6, 1.5, exposed > 0.0), code, 0.0); }
            return vec4<f32>(t, settled(prog), code, rem);
        }
    }

    // ---- iron rusts slowly when wet (faster in salt water) ----
    if (e == 40u && n_water > 0.0 && t < 2.0 && rnd < 0.0004 * (n_water + 3.0 * n_brine)) {
        return vec4<f32>(t, req_conv(17u), 0.0, 1.0);
    }

    // ---- chlorate / red phosphorus mixtures are friction sensitive: stirring can ignite them ----
    if ((e == 69u || e == 73u) && npart > 0.0 && P.nops > 0u) {
        for (var k = 0u; k < P.nops; k++) {
            let o = OPS[k];
            if (o.kind == 8u && in_shape(o, x, y) && rnd < 0.02 * npart) { t = max(t, best.x + 0.3); }
        }
    }

    // ---- ablative liner: chars under heat, the pyrolysis gas carries heat away (transpiration cooling) ----
    if (e == 87u && t > 2.5) {
        let r = 0.04 * (t - 2.5);
        rem -= dt * r;
        if (exposed > 0.0) { code = emit_code(5u, r * MATTER_MASS * 0.25 / ex); }
        t = max(2.5, t - dt * r * 3.0);
        if (rem < 0.5) { return vec4<f32>(t, req_conv(88u), 0.0, 1.0); }
        return vec4<f32>(t, settled(prog), code, rem);
    }
    // ---- char and graphite erode in a fast, hot, oxidising or high-pressure flow (throat erosion) ----
    if ((e == 88u || e == 86u) && exposed > 0.0 && gt_max > 8.0 && gp_max > 2.5) {
        rem -= dt * select(0.012, 0.004, e == 86u) * (gt_max - 8.0) * sqrt(gp_max);
        if (rem <= 0.0) { return vec4<f32>(t, 1.5, 0.0, 0.0); }
    }

    // ---- cast / pressed grain: flame cannot enter the solid, it burns layer by layer at the exposed surface ----
    let packed = (META[i] & CAST_BIT) != 0u;
    if (packed && npart > 0.0 && !thermite) {
        let inv = 1.0 / npart;
        let cb = csum * inv;
        let ign = cign * inv;
        // over-pressure cracks the grain (more binder = tougher): the fragments then burn like loose powder = CATO
        let p_crack = 60.0 * (1.0 + 1.5 * clamp(n_bind / 3.0, 0.0, 1.0));
        if (gp_avg > p_crack && rnd < 0.25) { return vec4<f32>(t, 0.94, code, rem); }
        let lit_contact = tn_max > ign + 1.0 && spread_ok(CAST_SPREAD * pfac, dt, rnd2);
        if (exposed > 0.0 && (t > ign || gt_max > ign + 0.8 || lit_contact)) {
            var r = cb.x * pow(clamp(gp_avg, 0.6, 200.0), cb.y);
            r *= 1.0 + 0.8 * clamp(n_cc * 0.5, 0.0, 1.0);          // copper chromite / iron oxide catalyst
            r *= 1.0 - 0.25 * clamp(n_bind / 3.0, 0.0, 1.0);       // binder slows the burn
            t = max(t, ign + 0.05) + (cb.z - max(t, ign + 0.05)) * 0.5;
            rem -= dt * r;
            code = emit_code(3u, r * MATTER_MASS * cb.w / ex);
            if (rem <= 0.0) { return vec4<f32>(t, 1.5, code, 0.0); }
            return vec4<f32>(t, settled(prog), code, rem);
        }
        // buried or unlit: inert (conducts heat only)
        return vec4<f32>(t, settled(prog), 0.0, rem);
    }

    // ---- oxidiser / fuel pairs (mixtures) ----
    let pair_contact = max(hot_partner, tn_max - 1.0) > best.x && spread_ok(spr * pfac, dt, rnd2);
    if (npart > 0.0 && (t > best.x || pair_contact)) {
        // ANFO only detonates when a strong shock arrives (needs a booster charge)
        if (anfo && gp_max > 12.0) { return vec4<f32>(t, 2.0, 0.0, rem); }
        var r = best.y * (npart / 8.0) * (1.0 + 0.5 * clamp(max(t, hot_partner) - best.x, 0.0, 4.0));
        // composite propellants burn faster under pressure (Saint-Robert's law)
        r *= pow(max(gp_max, 1.0), 0.4);
        // thermite: the oxide is reduced as fast as the metal burns (it ends up as the molten metal)
        if (thermite && (e == 17u || e == 59u)) { r *= 2.0; }
        rem -= dt * r;
        t += (best.z - t) * min(1.0, dt * r * 6.0);
        if (best.w > 0.0 && exposed > 0.0) {
            code = emit_code(3u, r * MATTER_MASS * best.w / ex);
        }
        if (rem <= 0.0) {
            if (thermite) {
                // the oxide becomes molten metal (iron -> steel, copper -> copper), the metal fuel becomes slag
                if (e == 17u || e == 59u) { return vec4<f32>(max(t, 9.0), req_conv(24u), 0.0, 1.0); }
                return vec4<f32>(t, req_conv(25u), 0.0, 1.0);
            }
            // (an unconfined pile whooshes: surface grains vent as they burn; only buried grains make a pressure pocket)
            return vec4<f32>(t, select(1.6, 1.5, exposed > 1.5), code, 0.0);
        }
        return vec4<f32>(t, settled(prog), code, rem);
    }

    // ---- lone oxidisers decompose when hot, releasing oxygen (feeds nearby fires) ----
    if (ox_e && E_PHASE[e] == 1u && tb < 90.0 && t > tb && exposed > 0.0) {
        let dr = 0.3 * (t - tb);
        rem -= dt * dr * exposed / MATTER_MASS;
        code = emit_code(select(2u, 3u, e == 18u), dr);
    }

    // ---- fuels burning at their surface in air (dust clouds burn explosively fast) ----
    // flame contact: a burning neighbour or a flame licking the surface lights it (grains, dust, paper)
    // (probabilistic: the flame creeps over the surface at E_SPREAD). Airborne dust grains equilibrate with the gas
    // almost at once, so hot gas above the cloud ignition temperature lights them directly: dust flames propagate
    // through the gas phase.
    let airborne = exposed >= 3.0 && E_PHASE[e] == 1u;
    let tig = E_TIGN_AIR[e];
    if (tig < 90.0 && exposed > 0.0) {
        let surf_lit = (tn_max > tig + 1.5 || gt_max > tig + 2.0) && spread_ok(E_SPREAD[e], dt, rnd2);
        let dust_lit = airborne && gt_max > tig + 0.5 && o2_avg > 0.03 && spread_ok(DUST_IGN, dt, rnd2);
        if (surf_lit || dust_lit) { t = max(t, tig + 0.05); }
    }
    if (t > tig && exposed > 0.0 && o2_avg > 0.02) {
        var rb = 3.0 * o2_avg * E_KBURN[e];
        if (airborne) { rb *= E_DUST[e]; }
        rem -= dt * rb * exposed / MATTER_MASS;
        // the particle glows at its burning temperature only while there is oxygen to burn: in a closed vessel the
        // heat release is limited by the O2 actually available (the gas side consumes it, 13 MJ per kg O2), so
        // the constant-volume peak stays near the real 7-9 bar instead of the particles acting as a heat source
        let o2f = clamp((o2_avg - 0.02) / 0.15, 0.0, 1.0);
        t += (E_TBURN_AIR[e] - t) * min(1.0, dt * 2.0) * o2f;
        code = emit_code(4u, rb);
    }

    // ---- melting / freezing with latent heat (the cell holds at the transition temperature) ----
    let to = E_PT_TO[e];
    if (to != 0u) {
        var thr = E_PT[e];
        if (e == 26u && n_salt > 0.0) { thr = 0.84; }     // salt melts ice (brine freezes at 252 K)
        if (is_liquid(e)) {
            if (t < thr - 0.005) { prog += (thr - t) / E_LFUS[e]; t = thr; }
            else { prog = max(prog - 0.02, 0.0); }
        } else {
            if (t > thr) { prog += (t - thr) / E_LFUS[e]; t = thr; }
            else { prog = max(prog - 0.02, 0.0); }
        }
        if (prog >= 1.0) { return vec4<f32>(t, req_conv(to), 0.0, 1.0); }
    }

    if (rem <= 0.0) {
        let bo = E_BURNOUT[e];
        if (bo != 0u && E_TIGN_AIR[e] < 90.0) { return vec4<f32>(t, req_conv(bo), 0.0, 1.0); }
        return vec4<f32>(t, 1.5, code, 0.0);
    }
    return vec4<f32>(t, settled(prog), code, rem);
}

// Gas-side counterpart: a gas cell receiving emission from a neighbouring matter cell j.
fn absorb_matter_emission(s_in: S, j: u32, dt: f32) -> S {
    var s = s_in;
    let wj = WALL[j];
    if (wj.z < 1.0) { return s; }
    let kind = u32(floor(wj.z / 1000.0));
    let rate = wj.z - f32(kind) * 1000.0;
    let dm = dt * rate;
    let e = elem_of(j);
    let tw = wj.x;
    if (kind == 1u) {
        // vapour into its gas slot: water/brine/acid/dry ice -> H2O/CO2 (products), fuels -> fuel, LOX -> O2, LN2 -> N2
        let v = E_VAP[e];
        if (v == 0u) { s.a.x += dm; s.b.z += dm * CV.x * tw; }
        else if (v == 1u) { s.a.y += dm; s.b.z += dm * CV.y * tw; }
        else if (v == 2u) { s.a.z += dm; s.b.z += dm * CV.z * tw; }
        else { s.a.w += dm; s.b.z += dm * CV.w * tw; }
        s.b.w += dm * E_VSOOT[e];
    } else if (kind == 2u) {
        s.a.y += dm;
        s.b.z += dm * CV.y * tw;
    } else if (kind == 3u) {
        s.a.w += dm;
        s.b.z += dm * CV.w * tw;
        s.b.w += dm * E_PSMOKE[e]; // potassium carbonate / alumina / TNT soot
    } else if (kind == 4u) {
        // glowing surface combustion consumes oxygen from this gas cell
        // (finite mixing/reaction time: a gas cell's oxygen is used up over ~1/K_SURF_O2 time units, comparable to
        // the acoustic time of a cell, so burning dust/surfaces don't make constant-volume pressure spikes)
        // The rate also falls with the local pressure (sub-grid flamelets burn at ~constant pressure and the burning
        // velocity of dust drops with p): an end-gas pocket that is already compressed burns while the pressure
        // equalises instead of in one step (no 20+ atm constant-volume spikes on top of the 7-8 atm vessel peak).
        let pl = max(pres(s) / 3.0, 1.0);
        let do2 = min(dm * 2.67, s.a.y * min(0.5, K_SURF_O2 * dt / (pl * pl)));
        s.a.y -= do2;
        s.a.w += do2 * 1.37;
        s.b.z += do2 * 80.0;
        s.b.w += do2 * E_BSOOT[e];
    } else if (kind == 5u) {
        // hydrogen (fuel slot) at the metal's temperature
        s.a.x += dm;
        s.b.z += dm * CV.x * tw;
    } else if (kind == 6u) {
        // 90 % peroxide: 42 % oxygen, 58 % steam by mass
        s.a.y += 0.42 * dm;
        s.a.w += 0.58 * dm;
        s.b.z += dm * (0.42 * CV.y + 0.58 * CV.w) * tw;
    } else if (kind == 7u) {
        s.a.w += dm;
        s.b.z += dm * CV.w * tw;
    }
    return s;
}

// ---- movement: Margolus 2x2 block cellular automaton (each thread owns one block, no races) ----

// 0 gas, 1 powder, 2 liquid, 3 immovable (walls, machines, static matter)
fn mkind(i: u32) -> u32 {
    let t = tile_of(i);
    if (t == 0u) { return 0u; }
    if (t == MATTER) {
        if ((META[i] & CAST_BIT) != 0u) { return 3u; }   // cast / pressed grain: fixed solid
        let ph = E_PHASE[elem_of(i)];
        return select(3u, ph, ph != 0u);
    }
    return 3u;
}
fn mdens(i: u32) -> f32 {
    if (tile_of(i) == MATTER) { return E_DENS[elem_of(i)]; }
    return 0.0;
}
fn movable(i: u32) -> bool { let k = mkind(i); return k == 1u || k == 2u; }
fn can_enter(src: u32, dst: u32) -> bool {
    let k = mkind(dst);
    if (k == 0u) { return true; }
    // denser things sink through liquids; a liquid also sinks under a lighter powder (sodium, wax flakes float)
    if (k == 2u) { return mdens(src) > mdens(dst) + 0.05; }
    if (k == 1u && mkind(src) == 2u) { return mdens(src) > mdens(dst) + 0.05; }
    return false;
}
fn swap_cells(a: u32, b: u32) {
    let ma = META[a];
    META[a] = META[b];
    META[b] = ma;
    let wa = WALL[a];
    WALL[a] = WALL[b];
    WALL[b] = wa;
    let sa = ld0(a);
    st0(a, ld0(b));
    st0(b, sa);
}

fn gas_vel(i: u32) -> vec2<f32> {
    if (tile_of(i) != 0u) { return vec2<f32>(0.0); }
    let st = ld0(i);
    return vec2<f32>(st.b.x, st.b.y) / max(rho_s(st), RHO_MIN);
}

// Apply a pending element conversion requested by matter_update (melting, freezing, dissolving, rusting...).
fn apply_conversion(i: u32) {
    if (tile_of(i) != MATTER) { return; }
    let w = WALL[i];
    if (w.y < 0.55 || w.y >= 0.95) { return; }
    if (w.y > 0.93) {
        // cracked grain: loses its packed state, the fragments are loose powder again
        META[i] = META[i] & ~CAST_BIT;
        WALL[i] = vec4<f32>(w.x, 0.3, w.z, w.w);
        return;
    }
    let to = min(u32(round((w.y - 0.55) * 1000.0)), N_ELEM - 1u);
    let src_e = elem_of(i);
    var z = 0.0;
    if (to == 24u) { z = select(0.5, 2.5, src_e == 59u); } // molten metal remembers what it freezes into
    META[i] = MATTER | (to << 8u);
    WALL[i] = vec4<f32>(w.x, 0.1, z, 1.0);
}

// stickiness / viscosity: does this cell skip flowing this pass?
fn stuck(i: u32, r: f32) -> bool {
    if (tile_of(i) != MATTER) { return false; }
    return r < E_VISC[elem_of(i)];
}
// fine powders drift instead of falling while surrounded by air
fn floats(i: u32, below_gas: bool, r: f32) -> bool {
    if (tile_of(i) != MATTER || !below_gas) { return false; }
    return r < E_SUSP[elem_of(i)];
}

fn stirrable(i: u32) -> bool { return mkind(i) <= 2u; }
fn stir_swap(i: u32, j: u32) {
    if (stirrable(i) && stirrable(j) && (mkind(i) != 0u || mkind(j) != 0u)) { swap_cells(i, j); }
}
fn stir_block(a: u32, b: u32, c: u32, d: u32, x: u32, y: u32, off: u32) {
    let r1 = mhash(x * 7u + 3u, y * 13u + off, P.frame * 11u + 1u);
    let r2 = mhash(y * 5u + 1u, x * 17u + off, P.frame * 7u + 5u);
    let r3 = mhash(x + y * 31u, off + 9u, P.frame * 3u + 2u);
    if (r1 < 0.5) { stir_swap(a, d); } else { stir_swap(b, c); }
    if (r2 < 0.5) { stir_swap(a, b); } else { stir_swap(c, d); }
    if (r3 < 0.5) { stir_swap(a, c); } else { stir_swap(b, d); }
}

fn move_block(g: vec3<u32>, off: i32) {
    let x0 = i32(g.x) * 2 + off - 1;
    let y0 = i32(g.y) * 2 + off - 1;
    if (x0 < 0 || y0 < 0 || x0 + 1 >= i32(P.w) || y0 + 1 >= i32(P.h)) { return; }
    let a = u32(y0) * P.w + u32(x0);
    let b = a + 1u;
    let c = a + P.w;
    let d = c + 1u;
    // Mix tool (op kind 8): stir the block, shuffling powders/liquids/gas into an intimate blend
    for (var k = 0u; k < P.nops; k++) {
        let o = OPS[k];
        if (o.kind == 8u && in_shape(o, x0, y0)) {
            stir_block(a, b, c, d, u32(x0), u32(y0), u32(off));
            return;
        }
    }
    apply_conversion(a);
    apply_conversion(b);
    apply_conversion(c);
    apply_conversion(d);
    let r1 = mhash(u32(x0), u32(y0), P.frame * 2u + u32(off));
    let r2 = mhash(u32(y0), u32(x0), P.frame * 3u + 7u);
    let r3 = mhash(u32(x0) + 17u, u32(y0) * 3u, P.frame * 5u + u32(off));
    let r4 = mhash(u32(x0) * 7u + 3u, u32(y0) + 11u, P.frame * 11u + u32(off));
    // drag: fast gas in this block (blast waves, jets, wind) carries powders and splashes liquids;
    // fine powders (flour, snow, dust) are carried by much gentler air
    let v = 0.25 * (gas_vel(a) + gas_vel(b) + gas_vel(c) + gas_vel(d));
    let sp = length(v);
    var susp = 0.0;
    if (tile_of(a) == MATTER) { susp = max(susp, E_SUSP[elem_of(a)]); }
    if (tile_of(b) == MATTER) { susp = max(susp, E_SUSP[elem_of(b)]); }
    if (tile_of(c) == MATTER) { susp = max(susp, E_SUSP[elem_of(c)]); }
    if (tile_of(d) == MATTER) { susp = max(susp, E_SUSP[elem_of(d)]); }
    let vthr = 0.6 * (1.0 - 0.85 * susp);
    if (sp > vthr && r3 < min((sp - vthr) * (0.5 + 2.0 * susp), 0.9)) {
        let right = abs(v.x) > abs(v.y) && v.x > 0.0;
        let left = abs(v.x) > abs(v.y) && v.x < 0.0;
        let down = abs(v.y) >= abs(v.x) && v.y > 0.0;
        if (right) {
            if (movable(a) && mkind(b) == 0u) { swap_cells(a, b); }
            if (movable(c) && mkind(d) == 0u) { swap_cells(c, d); }
        } else if (left) {
            if (movable(b) && mkind(a) == 0u) { swap_cells(b, a); }
            if (movable(d) && mkind(c) == 0u) { swap_cells(d, c); }
        } else if (down) {
            if (movable(a) && mkind(c) == 0u) { swap_cells(a, c); }
            if (movable(b) && mkind(d) == 0u) { swap_cells(b, d); }
        } else {
            if (movable(c) && mkind(a) == 0u) { swap_cells(c, a); }
            if (movable(d) && mkind(b) == 0u) { swap_cells(d, b); }
        }
        return;
    }
    if (P.gravity <= 0.0) { return; }
    // falling (gravity +y); airborne fine powder mostly hangs in the air
    let fa = floats(a, mkind(c) == 0u, r4);
    let fb = floats(b, mkind(d) == 0u, fract(r4 * 7.31));
    if (movable(a) && !fa && !stuck(a, fract(r1 * 3.7)) && can_enter(a, c)) { swap_cells(a, c); }
    if (movable(b) && !fb && !stuck(b, fract(r2 * 5.3)) && can_enter(b, d)) { swap_cells(b, d); }
    // sliding diagonally (powders keep an angle of repose, liquids always slide unless viscous)
    if (movable(a) && !fa && !stuck(a, r1) && !can_enter(a, c) && can_enter(a, d)) {
        let slip = select(0.55, 1.0, mkind(a) == 2u);
        if (r1 < slip) { swap_cells(a, d); }
    }
    if (movable(b) && !fb && !stuck(b, r2) && !can_enter(b, d) && can_enter(b, c)) {
        let slip = select(0.55, 1.0, mkind(b) == 2u);
        if (r2 < slip) { swap_cells(b, c); }
    }
    // liquids spread sideways
    if (r2 < 0.7) {
        if (mkind(c) == 2u && !stuck(c, r3) && can_enter(c, d)) { swap_cells(c, d); }
        else if (mkind(d) == 2u && !stuck(d, r3) && can_enter(d, c)) { swap_cells(d, c); }
        if (mkind(a) == 2u && !stuck(a, r3) && can_enter(a, b) && !can_enter(a, c)) { swap_cells(a, b); }
        else if (mkind(b) == 2u && !stuck(b, r3) && can_enter(b, a) && !can_enter(b, d)) { swap_cells(b, a); }
    }
}

@compute @workgroup_size(16, 16)
fn matter_move_a(@builtin(global_invocation_id) g: vec3<u32>) { move_block(g, 1); }

@compute @workgroup_size(16, 16)
fn matter_move_b(@builtin(global_invocation_id) g: vec3<u32>) { move_block(g, 0); }
